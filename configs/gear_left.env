# gear_left: bimanual human-demo dataset from h2r_collection, exported as
# LeRobot v2.1 and converted to v3.0 (scripts/convert_v21_to_v30_local.py).
#
# Modalities (verbatim from the dataset's meta/info.json: 72 episodes, 6704
# frames, 30 fps):
#   cameras: observation.images.{head, wrist_left, wrist_right}  (720x1280 video)
#   state:   observation.state  (14)   } identical names/layout, absolute values:
#   action:  action             (14)   }
#       0-2  left.wrist.x/y/z      3-5   left.wrist.roll/pitch/yaw
#       6-8  right.wrist.x/y/z     9-11  right.wrist.roll/pitch/yaw
#       12   left.gripper          13    right.gripper
#     i.e. BOTH wrists first, THEN both grippers -- not xyz/rpy/grip per arm.
#     So the Euler-angle dims are 3,4,5,9,10,11 and the grippers are 12,13.
#   task:    ""  (empty — no language annotation yet)

# DATASET / DATASET_ROOT are machine-specific, so they come from the untracked
# configs/local.env (see LOCAL_SETUP.md for its contents). Anything already set
# in the environment still wins.
_local="${BASH_SOURCE[0]%/*}/local.env"
if [[ -f "$_local" ]]; then
    source "$_local"
else
    echo "WARNING: $_local not found; set DATASET/DATASET_ROOT yourself" >&2
fi
unset _local

# pi0 only: pi0_base has three fixed camera slots with openpi names; map ours onto
# them (baked into the checkpoint's preprocessor, reused at inference).
# GR00T needs no map: with embodiment_tag=new_embodiment it takes the dataset's
# camera keys as-is and records them in its modality_configs.
PI0_RENAME_MAP='{"observation.images.head": "observation.images.base_0_rgb", "observation.images.wrist_left": "observation.images.left_wrist_0_rgb", "observation.images.wrist_right": "observation.images.right_wrist_0_rgb"}'

# Inpainting methods applied on the fly at dataloader time (arm inpainting, ...).
# Uncomment to remove the demonstrator's arm/hand from every training frame
# (Grounding DINO -> SAM2 -> LaMa; see src/h2r_il/transforms/). Dataset stays
# read-only. A method name, or a JSON spec for tuning, e.g.
#   INPAINTING='[{"name":"arm_inpaint","dilation":21,"prompt":"arm. hand."}]'
# INPAINTING=arm_inpaint
# INPAINTING_CACHE=  # defaults to outputs/inpaint_cache; override per machine

# Relative EEF actions: policy predicts (action - current state) for the 12 wrist
# dims; the grippers (12,13) stay absolute. RELATIVE_ANGLE_DIMS makes the
# conversion angle-aware -- right.wrist.yaw genuinely crosses the +pi/-pi seam in
# this dataset, and a plain subtraction turns that into a ~2pi delta (~800x the
# median), which would dominate GR00T's min/max relative-action stats.
RELATIVE_ACTIONS=1
RELATIVE_EXCLUDE_JOINTS='["gripper"]'
RELATIVE_ANGLE_DIMS='[3,4,5,9,10,11]'
